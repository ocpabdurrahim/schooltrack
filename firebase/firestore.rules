rules_version = '2';

// SchoolTrack -- see docs/data-model.md.
//
// This app is the system of record. It was first built beside an Oracle APEX
// app with a switch saying which system owned each module; that switch is gone
// (2026-11-15) because SchoolTrack now holds the data itself. Anything that
// still refers to a module "belonging" elsewhere is out of date.
//
// Two ideas carry most of the weight:
//
//   ROLES ("§2 Who may do what"). Access comes only from members/{email} or
//   guardians/{email}, which only an ADMIN may write. Signing in successfully
//   grants nothing by itself.
//
//   GUARDIANS. A guardian's reach is resolved ONLY from their own
//   guardians/{email} doc, never from a field on the student, and they have no
//   write path anywhere in the database.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ---------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The SchoolTrack owner, for first-run setup and support.
    function isAppAdmin() {
      return signedIn() && myEmail() in ['ocpabdurrahim@gmail.com'];
    }

    // ---------- staff ------------------------------------------------------

    function memberPath(s) {
      return /databases/$(database)/documents/schools/$(s)/members/$(myEmail());
    }

    // Roles: ADMIN, TEACHER, ACCOUNTS, plus OFFICE for document work.
    //
    // ONE document read, not four. Firestore caps the document accesses a
    // single rule evaluation may make, and these helpers nest. `let` binds the
    // read once. A missing member doc makes get() return null, the comparison
    // fails, and the request is denied, which is the outcome we want anyway.
    function hasRole(s, roles) {
      let m = get(memberPath(s));
      return signedIn() && m != null &&
             m.data.active == true &&
             m.data.get('deleted', false) == false &&
             m.data.role in roles;
    }

    function isStaff(s) {
      return hasRole(s, ['ADMIN', 'TEACHER', 'ACCOUNTS', 'OFFICE']);
    }

    function isAdmin(s) {
      return hasRole(s, ['ADMIN']);
    }

    // ---------- guardians --------------------------------------------------

    function guardianPath(s) {
      return /databases/$(database)/documents/schools/$(s)/guardians/$(myEmail());
    }

    function isGuardian(s) {
      let g = get(guardianPath(s));
      return signedIn() && g != null && g.data.active == true;
    }

    // "A guardian sees only the students listed in their own doc."
    // Resolved from the guardian's OWN document -- never from a field on the
    // student -- so a parent cannot widen their reach by editing anything.
    function guardianSees(s, studentId) {
      let g = get(guardianPath(s));
      return signedIn() && g != null && g.data.active == true &&
             g.data.studentIds.hasAny([studentId]);
    }

    // ---------- small write guards ----------------------------------------

    function stamped() {
      return request.resource.data.updatedAt == request.time;
    }

    // ======================================================================
    //  SCHOOL
    // ======================================================================
    match /schools/{s} {

      allow read: if isStaff(s) || isGuardian(s);
      allow write: if isAppAdmin();

      // ---- access control ---------------------------------------------------

      match /members/{email} {
        // staff can see who else has access; only ADMIN may grant it
        allow read: if isStaff(s) || isAppAdmin();
        allow write: if (isAdmin(s) || isAppAdmin()) && stamped();
      }

      match /guardians/{email} {
        // a guardian may read their OWN doc and nothing else in here, so they
        // can see which children they are linked to -- but never edit it
        allow read: if isAdmin(s) || isAppAdmin() || (signedIn() && email == myEmail());
        allow write: if (isAdmin(s) || isAppAdmin()) && stamped();
      }

      // ---- settings --------------------------------------------------------

      match /settings/{docId} {
        allow read: if isStaff(s) || isGuardian(s);
        allow write: if (isAdmin(s) || isAppAdmin()) && stamped();
      }

      // ---- integrations: the school's own API keys --------------------------
      //
      // A COLLECTION OF ITS OWN, and not a document under settings/, which
      // guardians can read. Rules are a union: a narrower rule on one document
      // inside a readable collection takes nothing away, so the only way to
      // keep a key from parents is to keep it out of there entirely.
      //
      // Read is narrower than isStaff() as well. ACCOUNTS and OFFICE never
      // scan a mark sheet, so they never need the key, and a key is worth
      // money to whoever holds it.
      match /integrations/{docId} {
        allow read: if hasRole(s, ['ADMIN', 'TEACHER']);
        allow write: if (isAdmin(s) || isAppAdmin()) && stamped();
      }

      // ---- people and reference data ---------------------------------------

      // A class may be DELETED, which almost nothing else here may.
      //
      // Removing is for mistakes — a section typed twice, a trial nobody
      // used. A class that has taught anybody is retired instead (active
      // false), which every listing filters while its records keep working.
      // The app establishes that nothing points at the class before it calls
      // this, because rules cannot: counting students, marks and attendance
      // would be several queries inside one evaluation, which Firestore caps.
      //
      // So this is a real widening and worth naming: an ADMIN may delete a
      // class that still has students, if they go around the app to do it.
      // The damage is bounded — a class document holds no history of its own,
      // and the records that point at it keep their own classId and roll, as
      // the results reports now show — and an ADMIN can already overwrite the
      // same document with `write`, which is no gentler.
      //
      // Delete is kept out of the stamped() guard on purpose: there is no
      // request.resource on a delete, so a single `write` rule with stamped()
      // refuses every removal.
      match /classes/{classId} {
        allow read: if isStaff(s) || isGuardian(s);
        allow create, update: if isAdmin(s) && stamped();
        allow delete: if isAdmin(s);
      }

      match /students/{studentId} {
        allow read: if isStaff(s) || guardianSees(s, studentId);
        allow write: if hasRole(s, ['ADMIN', 'OFFICE']) && stamped();
      }

      /**
       * A student's photograph, kept apart from the record itself so that
       * listing a section does not drag 78 pictures across with it.
       *
       * The size guard is the point of this block: a photo is a data URL in a
       * document, and a document may not exceed 1 MiB. 200_000 characters of
       * base64 is about 150 KB of JPEG -- above what the apps produce, below
       * anything that could threaten the limit -- so a client with a bug, or
       * someone poking at the API by hand, cannot wedge a record that then
       * refuses to load.
       */
      match /studentPhotos/{studentId} {
        allow read: if isStaff(s) || guardianSees(s, studentId);
        allow write: if hasRole(s, ['ADMIN', 'OFFICE'])
          && (request.method == 'delete' || (
            request.resource.data.jpeg is string
            && request.resource.data.jpeg.size() < 200000
            && request.resource.data.jpeg.matches('^data:image/jpeg;base64,.*')
          ));
      }

      match /staff/{staffId} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS', 'OFFICE']);
        allow write: if isAdmin(s) && stamped();
      }

      match /subjects/{subjectId} {
        allow read: if isStaff(s) || isGuardian(s);
        allow write: if isAdmin(s) && stamped();
      }

      // A holiday is the one record here that may be DELETED: a day marked by
      // mistake has to come back, and nothing else points at the document.
      // Delete is kept out of the stamped() guard on purpose -- there is no
      // request.resource on a delete, so a single `write` rule with stamped()
      // would refuse every removal.
      match /holidays/{date} {
        allow read: if isStaff(s) || isGuardian(s);
        allow create, update: if isAdmin(s) && stamped();
        allow delete: if isAdmin(s);
      }

      // ---- attendance -------------------------------------------------------
      // "§3 attendanceMarks/{date}_{studentId}" -- class, section and roll are
      // SNAPSHOTS taken when the mark is made (§4). The rules cannot prove the
      // values are right, but they force every write to carry them, so a
      // client that forgets fails loudly instead of writing a mark that can
      // never be attributed to a class later.
      //
      // FLAT, not attendance/{date}/marks/{id}. The nested shape needed a
      // COLLECTION-GROUP query for "one student across many days", and a
      // collection-group rule cannot be scoped to a school: it would have to
      // sit at the root, where it cannot tell one school's marks from
      // another's. Flat keeps every query ordinary and every rule scoped.

      // the day itself: records that attendance was opened at all, so
      // "not taken yet" stays distinguishable from "everyone absent"
      match /attendance/{date} {
        allow read: if isStaff(s) || isGuardian(s);
        allow write: if hasRole(s, ['ADMIN', 'TEACHER']) && stamped();
      }

      match /attendanceMarks/{markId} {
        allow read: if isStaff(s) || guardianSees(s, resource.data.studentId);

        allow create, update: if hasRole(s, ['ADMIN', 'TEACHER'])
          // the id IS the uniqueness: one mark per student per day
          && markId == request.resource.data.date + '_' + request.resource.data.studentId
          && request.resource.data.status in ['P', 'A', 'L', 'E']
          && request.resource.data.markedVia in ['SCAN', 'MANUAL']
          && request.resource.data.classId is string
          && request.resource.data.rollNo is number
          && request.resource.data.markedBy == myEmail()
          && request.resource.data.markedAt == request.time;

        // A register is corrected, not erased: flip the status instead.
        allow delete: if isAdmin(s);
      }

      // ---- fees ------------------------------------------------------------

      // The rate card. A GUARDIAN MAY READ IT, so their fees report can say
      // what is outstanding rather than only what has been paid -- a balance
      // cannot be worked out without knowing what was charged, and a school
      // publishes its fees anyway. A TEACHER still may not: money is not a
      // teacher's business here, and that was true before this line.
      // Per-student discounts stay in /discounts, which no guardian can read.
      match /feeHeads/{id} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS', 'OFFICE']) || isGuardian(s);
        allow write: if isAdmin(s) && stamped();
      }

      match /feeStructure/{id} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS', 'OFFICE']) || isGuardian(s);
        allow write: if isAdmin(s) && stamped();
      }

      match /discounts/{id} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS']);
        allow write: if isAdmin(s) && stamped();
      }

      match /payments/{paymentId} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS']) ||
                       guardianSees(s, resource.data.studentId);

        // "§5 Sequential receipt and voucher numbers" -- the receipt number
        // comes from counters/receipts inside the same transaction. Lines carry
        // the gross and discount AS COLLECTED (§4), so a later rate change
        // cannot rewrite an old receipt.
        allow create: if hasRole(s, ['ADMIN', 'ACCOUNTS'])
          && request.resource.data.receiptNo is string
          && request.resource.data.studentId is string
          && request.resource.data.lines.size() > 0
          && request.resource.data.createdBy == myEmail();

        // A receipt is never edited or deleted. Money that was taken wrongly is
        // corrected with another document, the way the paper ledger does it.
        allow update, delete: if false;
      }

      match /counters/{counterId} {
        // every module hands out its own numbers here: receipts, vouchers,
        // student and staff numbers
        allow read: if isStaff(s);
        // only ever forwards, and only by one
        allow write: if isStaff(s)
          && request.resource.data.next is int
          && (!exists(/databases/$(database)/documents/schools/$(s)/counters/$(counterId))
              || request.resource.data.next == resource.data.next + 1);
      }

      // ---- expenses --------------------------------------------------------

      match /expenseHeads/{id} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS']);
        allow write: if isAdmin(s) && stamped();
      }

      match /expenses/{id} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS']);
        allow write: if hasRole(s, ['ADMIN', 'ACCOUNTS']) && stamped();
      }

      // ---- exams and results -----------------------------------------------

      match /exams/{examId} {
        allow read: if isStaff(s) || isGuardian(s);
        allow write: if isAdmin(s) && stamped();
      }

      match /results/{resultId} {
        allow read: if isStaff(s) || guardianSees(s, resource.data.studentId);
        allow write: if hasRole(s, ['ADMIN', 'TEACHER']) && stamped();
      }

      // ---- payroll: never visible to anyone but ADMIN ----------------------

      match /salaryStructure/{id} {
        allow read: if isAdmin(s);
        allow write: if isAdmin(s) && stamped();
      }

      match /salaryPayments/{id} {
        allow read: if isAdmin(s);
        allow write: if isAdmin(s) && stamped();
      }

      // ---- issued documents -------------------------------------------------

      match /documents/{id} {
        allow read: if hasRole(s, ['ADMIN', 'OFFICE']);
        allow write: if hasRole(s, ['ADMIN', 'OFFICE']) && stamped();
      }

      // ---- generated reports -------------------------------------------------

      match /reports/{reportId} {
        allow read: if hasRole(s, ['ADMIN', 'ACCOUNTS']);
        allow write: if false;   // written by a Cloud Function (Admin SDK)
      }
    }

    // Anything not named above is denied. New collections must be added here
    // deliberately rather than inheriting someone else's permissions.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

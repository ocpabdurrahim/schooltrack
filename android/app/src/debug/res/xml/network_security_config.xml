<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. The Firebase emulators speak plain HTTP, and Android has
  blocked cleartext by default since API 28 — which is why -PuseEmulators=true
  silently failed at first and every sign-in came back "did not match".

  Cleartext is permitted broadly here rather than for a fixed list of hosts:
  the development machine's LAN address changes between networks, and pinning
  one would simply fail somewhere else. This file is NOT part of a release
  build, so production traffic stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

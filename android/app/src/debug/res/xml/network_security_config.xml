<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. The Firebase emulators speak plain HTTP, and Android has
  blocked cleartext by default since API 28 — which is why -PuseEmulators=true
  silently failed to connect and every sign-in came back "did not match".

  Only the host loopback addresses are permitted: 10.0.2.2 is the developer's
  machine as seen from an Android emulator. Release builds do not include this
  file at all, so production traffic stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

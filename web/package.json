    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
